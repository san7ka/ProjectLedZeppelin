<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.28.xsd">

    <changeSet id="1.4.0" author="lepeshinskij">
        <createTable tableName="games">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_games_user" references="users(id)"/>
            </column>
            <column name="quest_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_games_quest" references="quests(id)"/>
            </column>
            <column name="result" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="finished_at" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
