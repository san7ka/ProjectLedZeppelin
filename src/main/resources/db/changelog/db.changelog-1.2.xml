    <changeSet id="1.2-insert-space-quest-stages" author="system">
        <!-- Space Quest Stages -->
        <insert tableName="quest_stages">
            <column name="quest_id" value="2"/>
            <column name="stage_id" value="space_start"/>
            <column name="title" value="Космическая станция"/>
            <column name="description" value="Вы находитесь на космической станции. Куда отправитесь?"/>
            <column name="result_type" value="NONE"/>
            <column name="stage_index" value="1"/>
        </insert>

        <insert tableName="quest_stages">
            <column name="quest_id" value="2"/>
            <column name="stage_id" value="space_explore"/>
            <column name="title" value="Исследование планеты"/>
            <column name="description" value="Вы приземлились на неизвестную планету. Что будете делать?"/>
            <column name="result_type" value="NONE"/>
            <column name="stage_index" value="2"/>
