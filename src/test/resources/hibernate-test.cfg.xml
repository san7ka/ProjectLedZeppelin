<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 5.6.0.Final//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-5.6.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- Database Connection Properties -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>

        <!-- Connection Pool Settings -->
        <property name="hibernate.connection.provider_class">com.zaxxer.hikari.hibernate.HikariConnectionProvider</property>
        <property name="hibernate.hikari.maximumPoolSize">5</property>
        <property name="hibernate.hikari.minimumIdle">1</property>
        <property name="hibernate.hikari.connectionTimeout">30000</property>
        <property name="hibernate.hikari.idleTimeout">600000</property>
        <property name="hibernate.hikari.maxLifetime">1800000</property>

        <!-- Hibernate Dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

        <!-- SQL Logging (disabled for tests) -->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">false</property>
        <property name="hibernate.use_sql_comments">false</property>

        <!-- Schema Management -->
        <property name="hibernate.hbm2ddl.auto">create-drop</property>
        <property name="hibernate.hbm2ddl.import_files">test-data.sql</property>

        <!-- Batch Processing -->
        <property name="hibernate.jdbc.batch_size">20</property>
        <property name="hibernate.jdbc.batch_versioned_data">true</property>
        <property name="hibernate.order_inserts">true</property>
        <property name="hibernate.order_updates">true</property>
        <property name="hibernate.connection.provider_disables_autocommit">true</property>

        <!-- Caching (disabled for tests) -->
        <property name="hibernate.cache.use_second_level_cache">false</property>
        <property name="hibernate.cache.use_query_cache">false</property>

        <!-- Lazy Loading -->
        <property name="hibernate.enable_lazy_load_no_trans">true</property>
        <property name="hibernate.default_batch_fetch_size">16</property>
        <property name="hibernate.jdbc.fetch_size">50</property>

        <!-- Connection Management -->
        <property name="hibernate.jdbc.lob.non_contextual_creation">true</property>
        <property name="hibernate.connection.autocommit">false</property>

        <!-- Statistics (enabled for tests) -->
        <property name="hibernate.generate_statistics">true</property>
        <property name="hibernate.session.events.log.LOG_QUERIES_SLOWER_THAN_MS">100</property>

        <!-- Entity Mappings -->
        <mapping class="com.javarush.lepeshinskij.entity.User"/>
        <mapping class="com.javarush.lepeshinskij.entity.Quest"/>
        <mapping class="com.javarush.lepeshinskij.entity.QuestStage"/>
        <mapping class="com.javarush.lepeshinskij.entity.QuestStageOption"/>
        <mapping class="com.javarush.lepeshinskij.entity.UserQuestProgress"/>

    </session-factory>
</hibernate-configuration>
